{
  "name": "codictate-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "fetch-crispasr": "bun scripts/fetch-crispasr.ts",
    "fetch-llama": "bun scripts/fetch-llama.ts",
    "fetch-parakeet": "bun scripts/fetch-parakeet.ts",
    "fetch-onnxruntime": "bun scripts/fetch-onnxruntime.ts",
    "prebuild:ios": "bun run fetch-crispasr && bun run fetch-llama && bun run fetch-parakeet && bun run fetch-onnxruntime && expo prebuild --platform ios",
    "prebuild": "bun run fetch-crispasr && bun run fetch-llama && bun run fetch-parakeet && bun run fetch-onnxruntime && expo prebuild",
    "eas-build-post-install": "bun run fetch-crispasr && bun run fetch-llama && bun run fetch-parakeet && bun run fetch-onnxruntime",
    "eas:development": "dotenv -e .env -- eas build --profile development --platform ios --auto-submit",
    "eas:preview": "dotenv -e .env -- eas build --profile preview --platform ios --auto-submit",
    "eas:production": "dotenv -e .env -- eas build --profile production --platform ios --auto-submit",
    "eas:development-local": "dotenv -e .env -- eas build --profile development --platform ios --local",
    "eas:preview-local": "dotenv -e .env -- eas build --profile preview --platform ios --local",
    "eas:production-local": "dotenv -e .env -- eas build --profile production --platform ios --local",
    "eas:submit": "dotenv -e .env -- eas submit --platform ios",
    "eas:release-local": "./scripts/release-ios.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@expo-google-fonts/iceberg": "^0.4.1",
    "@expo-google-fonts/iceland": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "codictate-dictation": "file:./modules/codictate-dictation",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.58.1"
  },
  "private": true
}
